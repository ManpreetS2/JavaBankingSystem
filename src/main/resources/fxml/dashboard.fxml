<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.manpreet.bank.controller.DashboardController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="content-scroll">

    <VBox spacing="16" styleClass="content-root">
        <VBox spacing="4" styleClass="page-header">
            <Label text="Dashboard" styleClass="page-title"/>
            <Label fx:id="subtitleLabel" text="Your balances and recent activity" styleClass="page-subtitle, body-secondary"/>
            <Label fx:id="statusLabel" styleClass="success-text" managed="false" visible="false"/>
        </VBox>

        <VBox spacing="8" styleClass="hero-card">
            <Label text="Total balance" styleClass="metric-label"/>
            <Label fx:id="totalBalanceLabel" text="\$0.00" styleClass="balance-primary"/>
            <Label text="Combined checking and savings" styleClass="caption"/>
        </VBox>

        <HBox spacing="16">
            <VBox spacing="8" styleClass="account-card" HBox.hgrow="ALWAYS">
                <Label text="Checking" styleClass="card-title"/>
                <Label fx:id="checkingNumberLabel" styleClass="body-secondary"/>
                <Label fx:id="checkingBalanceLabel" text="\$0.00" styleClass="balance-secondary"/>
            </VBox>
            <VBox spacing="8" styleClass="account-card" HBox.hgrow="ALWAYS">
                <Label text="Savings" styleClass="card-title"/>
                <Label fx:id="savingsNumberLabel" styleClass="body-secondary"/>
                <Label fx:id="savingsBalanceLabel" text="\$0.00" styleClass="balance-secondary"/>
            </VBox>
        </HBox>

        <VBox spacing="12" styleClass="action-card">
            <Label text="Quick actions" styleClass="section-title"/>
            <HBox spacing="12" styleClass="quick-actions">
                <Button text="Deposit" onAction="#handleDeposit" styleClass="button-primary"/>
                <Button text="Withdraw" onAction="#handleWithdraw" styleClass="button-secondary"/>
                <Button text="Transfer" onAction="#handleTransfer" styleClass="button-secondary"/>
            </HBox>
        </VBox>

        <Label text="Recent activity" styleClass="section-title"/>
        <VBox fx:id="emptyStateBox" spacing="8" styleClass="empty-state-card" managed="false" visible="false">
            <Label text="No recent activity" styleClass="card-title"/>
            <Label text="Deposits, withdrawals, and transfers will appear here." styleClass="body-secondary"/>
        </VBox>
        <TableView fx:id="transactionsTable" styleClass="transactions-table" prefHeight="280" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="160"/>
                <TableColumn fx:id="accountColumn" text="Account" prefWidth="160"/>
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="260"/>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
                <TableColumn fx:id="amountColumn" text="Amount" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</ScrollPane>
