<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.manpreet.bank.controller.DashboardController"
      spacing="16"
      styleClass="content-root">

    <Label text="Overview" styleClass="section-title"/>
    <Label fx:id="subtitleLabel" text="Your balances and recent activity" styleClass="body-secondary"/>
    <Label fx:id="statusLabel" styleClass="success-text"/>

    <VBox spacing="8" styleClass="metric-card">
        <Label text="Total balance" styleClass="metric-label"/>
        <Label fx:id="totalBalanceLabel" text="$0.00" styleClass="balance-primary"/>
        <Label text="Checking + Savings" styleClass="caption"/>
    </VBox>

    <HBox spacing="16">
        <VBox spacing="8" styleClass="account-card" HBox.hgrow="ALWAYS">
            <Label text="Checking" styleClass="section-title"/>
            <Label fx:id="checkingNumberLabel" styleClass="body-secondary"/>
            <Label fx:id="checkingBalanceLabel" text="$0.00" styleClass="balance-primary"/>
        </VBox>
        <VBox spacing="8" styleClass="account-card" HBox.hgrow="ALWAYS">
            <Label text="Savings" styleClass="section-title"/>
            <Label fx:id="savingsNumberLabel" styleClass="body-secondary"/>
            <Label fx:id="savingsBalanceLabel" text="$0.00" styleClass="balance-primary"/>
        </VBox>
    </HBox>

    <HBox spacing="12">
        <Button text="Deposit" onAction="#handleDeposit" styleClass="button-primary" defaultButton="true"/>
        <Button text="Withdraw" onAction="#handleWithdraw" styleClass="button-secondary"/>
        <Button text="Transfer" onAction="#handleTransfer" styleClass="button-secondary"/>
    </HBox>

    <Label text="Recent activity" styleClass="section-title"/>
    <Label fx:id="emptyStateLabel" text="No recent transactions yet." styleClass="empty-state body-secondary" managed="false" visible="false"/>
    <TableView fx:id="transactionsTable" styleClass="transactions-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="140"/>
            <TableColumn fx:id="accountColumn" text="Account" prefWidth="160"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="240"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="160"/>
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
