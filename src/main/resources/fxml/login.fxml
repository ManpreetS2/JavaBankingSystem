<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.manpreet.bank.controller.LoginController"
      spacing="12"
      styleClass="auth-root">

    <Label text="Banking System" styleClass="page-title"/>
    <Label text="Sign in to continue" styleClass="body-secondary"/>

    <Label fx:id="infoLabel" styleClass="success-text"/>
    <Label fx:id="errorLabel" styleClass="error-text"/>

    <TextField fx:id="usernameOrEmailField" promptText="Username or email" styleClass="input"/>
    <PasswordField fx:id="passwordField" promptText="Password" styleClass="input"/>

    <Button text="Login" onAction="#handleLogin" styleClass="button-primary" defaultButton="true"/>
    <Button text="Create account" onAction="#goToRegister" styleClass="button-secondary"/>
</VBox>
