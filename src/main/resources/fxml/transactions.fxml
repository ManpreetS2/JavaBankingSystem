<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.manpreet.bank.controller.TransactionsController"
      spacing="16"
      styleClass="content-root">

    <VBox spacing="4" styleClass="page-header">
        <Label text="Transactions" styleClass="page-title"/>
        <Label text="Review and search account activity" styleClass="page-subtitle, body-secondary"/>
        <Label fx:id="statusLabel" styleClass="success-text"/>
    </VBox>

    <FlowPane hgap="12" vgap="12" styleClass="summary-row">
        <VBox spacing="4" styleClass="metric-card" prefWidth="160">
            <Label text="Matching results" styleClass="metric-label"/>
            <Label fx:id="matchingCountLabel" text="0" styleClass="metric-value"/>
            <Label text="Current filters" styleClass="caption"/>
        </VBox>
        <VBox spacing="4" styleClass="metric-card" prefWidth="160">
            <Label text="Deposits" styleClass="metric-label"/>
            <Label fx:id="depositsTotalLabel" text="$0.00" styleClass="metric-value"/>
            <Label text="All activity" styleClass="caption"/>
        </VBox>
        <VBox spacing="4" styleClass="metric-card" prefWidth="160">
            <Label text="Withdrawals" styleClass="metric-label"/>
            <Label fx:id="withdrawalsTotalLabel" text="$0.00" styleClass="metric-value"/>
            <Label text="All activity" styleClass="caption"/>
        </VBox>
        <VBox spacing="4" styleClass="metric-card" prefWidth="160">
            <Label text="Transfers in" styleClass="metric-label"/>
            <Label fx:id="transfersInTotalLabel" text="$0.00" styleClass="metric-value"/>
            <Label text="All activity" styleClass="caption"/>
        </VBox>
        <VBox spacing="4" styleClass="metric-card" prefWidth="160">
            <Label text="Transfers out" styleClass="metric-label"/>
            <Label fx:id="transfersOutTotalLabel" text="$0.00" styleClass="metric-value"/>
            <Label text="All activity" styleClass="caption"/>
        </VBox>
    </FlowPane>

    <VBox spacing="12" styleClass="filter-panel">
        <Label text="Filters" styleClass="section-title"/>
        <FlowPane hgap="12" vgap="12">
            <VBox spacing="4" styleClass="field-group">
                <Label text="Search" styleClass="field-label"/>
                <TextField fx:id="searchField" promptText="Description contains…" styleClass="input"
                           onAction="#handleSearch" prefWidth="220"/>
            </VBox>
            <VBox spacing="4" styleClass="field-group">
                <Label text="Account" styleClass="field-label"/>
                <ComboBox fx:id="accountFilter" styleClass="input" prefWidth="200"/>
            </VBox>
            <VBox spacing="4" styleClass="field-group">
                <Label text="Type" styleClass="field-label"/>
                <ComboBox fx:id="typeFilter" styleClass="input" prefWidth="160"/>
            </VBox>
            <VBox spacing="4" styleClass="field-group">
                <Label text="Start date" styleClass="field-label"/>
                <DatePicker fx:id="startDatePicker" styleClass="input" prefWidth="150"/>
            </VBox>
            <VBox spacing="4" styleClass="field-group">
                <Label text="End date" styleClass="field-label"/>
                <DatePicker fx:id="endDatePicker" styleClass="input" prefWidth="150"/>
            </VBox>
        </FlowPane>
        <HBox spacing="8" styleClass="quick-actions">
            <Button text="Search" onAction="#handleSearch" styleClass="button-primary" defaultButton="true"/>
            <Button text="Reset filters" onAction="#handleResetFilters" styleClass="button-secondary"/>
            <Button text="Export CSV" onAction="#handleExportCsv" styleClass="button-ghost"/>
        </HBox>
    </VBox>

    <VBox fx:id="emptyStateBox" spacing="8" styleClass="empty-state-card" managed="false" visible="false">
        <Label text="No matching transactions" styleClass="card-title"/>
        <Label text="Try adjusting your search, account, type, or date filters." styleClass="body-secondary"/>
        <Label fx:id="emptyStateLabel" managed="false" visible="false"/>
    </VBox>

    <TableView fx:id="transactionsTable" styleClass="transactions-table" VBox.vgrow="ALWAYS" minHeight="180">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="140"/>
            <TableColumn fx:id="accountColumn" text="Account" prefWidth="160"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="170"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="260"/>
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="12" styleClass="pagination-bar">
        <Button fx:id="previousPageButton" text="Previous" onAction="#handlePreviousPage" styleClass="button-secondary, button-compact"/>
        <Label fx:id="pageLabel" text="Page 1 of 1" styleClass="body-secondary"/>
        <Button fx:id="nextPageButton" text="Next" onAction="#handleNextPage" styleClass="button-secondary, button-compact"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox spacing="12" styleClass="detail-panel">
        <Label text="Transaction details" styleClass="section-title"/>
        <Label fx:id="detailPlaceholderLabel" text="Select a transaction to view details."
               styleClass="body-secondary"/>
        <GridPane fx:id="detailGrid" styleClass="detail-grid" managed="false" visible="false">
            <columnConstraints>
                <ColumnConstraints minWidth="120" prefWidth="140"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Type" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="detailTypeLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Amount" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="detailAmountLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Account" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="detailAccountLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Related account" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Label fx:id="detailRelatedLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label text="Description" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Label fx:id="detailDescriptionLabel" styleClass="detail-value" wrapText="true"
                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            <Label text="Date" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <Label fx:id="detailDateLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        </GridPane>
    </VBox>
</VBox>
