<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.manpreet.bank.controller.TransactionsController"
      spacing="16"
      styleClass="content-root">

    <Label text="Transactions" styleClass="section-title"/>
    <Label text="Review and search account activity" styleClass="body-secondary"/>
    <Label fx:id="statusLabel" styleClass="success-text"/>

    <HBox spacing="12" styleClass="summary-row">
        <VBox spacing="4" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Matching results" styleClass="metric-label"/>
            <Label fx:id="matchingCountLabel" text="0" styleClass="balance-primary"/>
            <Label text="Current filters" styleClass="caption"/>
        </VBox>
        <VBox spacing="4" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Deposits" styleClass="metric-label"/>
            <Label fx:id="depositsTotalLabel" text="$0.00" styleClass="balance-primary"/>
            <Label text="All activity" styleClass="caption"/>
        </VBox>
        <VBox spacing="4" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Withdrawals" styleClass="metric-label"/>
            <Label fx:id="withdrawalsTotalLabel" text="$0.00" styleClass="balance-primary"/>
            <Label text="All activity" styleClass="caption"/>
        </VBox>
        <VBox spacing="4" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Transfers in" styleClass="metric-label"/>
            <Label fx:id="transfersInTotalLabel" text="$0.00" styleClass="balance-primary"/>
            <Label text="All activity" styleClass="caption"/>
        </VBox>
        <VBox spacing="4" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="Transfers out" styleClass="metric-label"/>
            <Label fx:id="transfersOutTotalLabel" text="$0.00" styleClass="balance-primary"/>
            <Label text="All activity" styleClass="caption"/>
        </VBox>
    </HBox>

    <VBox spacing="10" styleClass="filter-panel">
        <Label text="Filters" styleClass="section-title"/>
        <FlowPane hgap="12" vgap="12">
            <VBox spacing="4">
                <Label text="Search" styleClass="caption"/>
                <TextField fx:id="searchField" promptText="Description contains…" styleClass="input"
                           onAction="#handleSearch" prefWidth="220"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Account" styleClass="caption"/>
                <ComboBox fx:id="accountFilter" styleClass="input" prefWidth="200"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Type" styleClass="caption"/>
                <ComboBox fx:id="typeFilter" styleClass="input" prefWidth="160"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Start date" styleClass="caption"/>
                <DatePicker fx:id="startDatePicker" styleClass="input" prefWidth="150"/>
            </VBox>
            <VBox spacing="4">
                <Label text="End date" styleClass="caption"/>
                <DatePicker fx:id="endDatePicker" styleClass="input" prefWidth="150"/>
            </VBox>
        </FlowPane>
        <HBox spacing="8">
            <Button text="Search" onAction="#handleSearch" styleClass="button-primary" defaultButton="true"/>
            <Button text="Reset filters" onAction="#handleResetFilters" styleClass="button-secondary"/>
            <Button text="Export CSV" onAction="#handleExportCsv" styleClass="button-secondary"/>
        </HBox>
    </VBox>

    <Label fx:id="emptyStateLabel" text="No transactions match these filters."
           styleClass="empty-state body-secondary" managed="false" visible="false"/>

    <TableView fx:id="transactionsTable" styleClass="transactions-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="160"/>
            <TableColumn fx:id="accountColumn" text="Account" prefWidth="180"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="180"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="240"/>
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="previousPageButton" text="Previous" onAction="#handlePreviousPage" styleClass="button-secondary"/>
        <Label fx:id="pageLabel" text="Page 1 of 1" styleClass="body-secondary"/>
        <Button fx:id="nextPageButton" text="Next" onAction="#handleNextPage" styleClass="button-secondary"/>
        <HBox HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox spacing="6" styleClass="detail-panel">
        <Label text="Transaction details" styleClass="section-title"/>
        <TextArea fx:id="detailArea" editable="false" wrapText="true" prefRowCount="4"
                  promptText="Select a transaction to view details." styleClass="input"/>
    </VBox>
</VBox>
